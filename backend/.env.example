# TUFAN Web Page Backend Environment Variables
# --------------------------------------------------
# Bu dosyayı Render.com üzerinde Secret Files olarak ekleyebilirsiniz.
# Render için Yol (Path): /etc/secrets/.env
# Local geliştirme için: backend/.env dosyasına kopyalayabilirsiniz.

# Veritabanı Bağlantısı (PostgreSQL / NeonDB / SQLite)
DATABASE_URL=postgresql://user:password@localhost:5432/mydatabase

# Admin Paneli Giriş Bilgileri
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sizin_belirleyeceginiz_guvenli_sifre
